<?xml version="1.0" encoding="utf-8"?>
<!-- Zone background for the data field. Rounded to the same radius as Karoo's own fields, so the
     color stops where their boundary does instead of squaring off the corners. Shares its red
     with the in-ride alert. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/partnerride_red" />
    <corners android:radius="@dimen/field_corner_radius" />
</shape>
